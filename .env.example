# Core paths/origins (optional defaults shown)
ARTIFACTS_JSON_PATH=../data/artifacts.json
ASSETS_DIR=../assets/clean_artifacts
FRONTEND_ORIGIN=http://localhost:5173

# Narrator: OpenAI-compatible chat-completions provider
NARRATOR_PROVIDER=glm
NARRATOR_MODEL=your_narrator_model_here
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=your_provider_api_key_here
NARRATOR_TEMPERATURE=0.5
NARRATOR_MAX_TOKENS=2048

# Optional structured-experience copy enhancement; curated fallback is default
EXPERIENCE_LLM_ENABLED=false

# Vision: reuse a named provider pair above, or configure a dedicated endpoint
VISION_PROVIDER=glm
VISION_MODEL=your_multimodal_model_here
# VISION_BASE_URL=https://your-vision-provider.example/v1
# VISION_API_KEY=your_vision_provider_api_key_here
VISION_TIMEOUT_SECONDS=20

# ElevenLabs TTS; text-only fallback remains available when unset
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_EN=your_english_voice_id_here
ELEVENLABS_VOICE_ID_AR=your_arabic_voice_id_here
TTS_STABILITY=0.21
TTS_STYLE=0.3
TTS_SIMILARITY_BOOST=0.75

# Frontend: place this value in frontend/.env, not in browser code
# VITE_API_BASE_URL=http://localhost:8000
