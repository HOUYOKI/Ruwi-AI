# Anthropic (Claude) API key — required. Never commit the real value.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinned Claude model used for /chat. Change here (or override in the environment)
# to roll to a new model version without touching code.
CLAUDE_MODEL=claude-sonnet-5

# Optional overrides — defaults resolve relative to backend/main.py
# ARTIFACTS_JSON_PATH=../data/artifacts.json
# ASSETS_DIR=../assets/clean_artifacts
# FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Narrator agent (required — app won't start without these)
NARRATOR_PROVIDER=glm
NARRATOR_MODEL=your_narrator_model_here
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=your_glm_api_key_here

# Narrator tuning (optional)
NARRATOR_TEMPERATURE=0.5
NARRATOR_MAX_TOKENS=2048

# TTS (optional — text-only fallback if unset)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_EN=your_english_voice_id_here
ELEVENLABS_VOICE_ID_AR=your_arabic_voice_id_here
TTS_STABILITY=0.21
TTS_STYLE=0.3
TTS_SIMILARITY_BOOST=0.75
