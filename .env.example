APP_ENV=development
APP_NAME=Ruwi
DEBUG=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql+psycopg://ruwi:ruwi@db:5432/ruwi
TEST_DATABASE_URL=sqlite+pysqlite:///./test_ruwi.db
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=20
LOCAL_STORAGE_DIR=/app/storage
STORAGE_PROVIDER=local
AI_PROVIDER=none
AI_API_KEY=
VISION_MODEL=gemini-2.5-flash
TEXT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
TTS_PROVIDER=browser
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
DEMO_SEED=true
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_CURATOR_EMAIL=curator@example.com
DEMO_CURATOR_PASSWORD=Curator123!
DEMO_VISITOR_EMAIL=visitor@example.com
DEMO_VISITOR_PASSWORD=Visitor123!
