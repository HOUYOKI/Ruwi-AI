# Anthropic (Claude) API key — required. Never commit the real value.
ANTHROPIC_API_KEY=

# Pinned Claude model used for /chat. Change here (or override in the environment)
# to roll to a new model version without touching code.
CLAUDE_MODEL=claude-sonnet-5

# Optional overrides — defaults resolve relative to backend/main.py
# ARTIFACTS_JSON_PATH=../data/artifacts.json
# ASSETS_DIR=../assets/clean_artifacts
# FRONTEND_ORIGIN=http://localhost:5173
